# ==============================================================================
# VIPER — Environment Configuration
# Copy this file to .env and fill in the values
# ==============================================================================

# --- Backends -----------------------------------------------------------------
# AI backend selection. Use "auto" to detect based on hardware.
# Options: auto | mlx_whisper | faster_whisper | openai
VIPER_STT_BACKEND=auto

# Options: auto | mlx_lm | openai
VIPER_LLM_BACKEND=auto

# Options: kokoro | openai
VIPER_TTS_BACKEND=kokoro

# --- Models & API Configuration ----------------------------------------------
WHISPER_MODEL=large-v3-turbo

# OpenAI or any OpenAI-compatible endpoint (Ollama, vLLM, LM Studio, Groq, etc.)
OPENAI_BASE_URL=http://localhost:11434/v1
OPENAI_MODEL=gpt-4o-mini
OPENAI_API_KEY=

# --- Storage ------------------------------------------------------------------
# SQLite (default, zero deps). For PostgreSQL: postgresql+asyncpg://user:pass@host/db
DATABASE_URL=sqlite+aiosqlite:///data/viper.db

VIPER_MEDIA_DIR=data/media

# --- Server -------------------------------------------------------------------
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO
